# ZenTao MCP 服务器环境变量模板
# 用法：复制为 .env 并填入实际值（.env 已被 .gitignore 忽略，不会被提交）
#   cp .env.example .env
#
# 用 `npx -y @michael-py001/zendao-mcp init` 安装时，凭证会写到
# ~/.zendao-mcp/.env（密码以 ZENTAO_PASSWORD_B64 保存），不需要手动复制本文件。
# 服务端还会读该用户级 .env；ZENDAO_ENV_FILE 可显式指定另一份 .env。
# 注意：ZENDAO_ENV_FILE（本项目的环境文件）和 ZENTAO_CONFIG_FILE（官方 CLI 的 profile）是两个不同变量。

# ---------- 禅道地址 ----------
# 填「站点根地址」。不要带 /index.php —— 那会打到前台路由、返回登录页 HTML 而不是 JSON。
# 形如：http://zen.example.com/zentaomax
# 别名：官方 CLI 用的是 ZENTAO_URL，本项目同样识别（ZENTAO_BASE_URL 优先）。
ZENTAO_BASE_URL=http://your-zentao-host/zentaomax

# ---------- REST API 版本 ----------
# v2（默认）= 禅道 API 2.0，路径 /api.php/v2，覆盖 26 个模块（项目/执行/任务/需求/Bug…）
# v1         = 旧版 API，路径 /api.php/v1，仅为极老版本保留
# 提示：任务、执行这类模块在 2.0 下才有正确语义，一般不需要改这一项。
# ZENTAO_API_VERSION=v2

# ---------- 认证（三选一，按下面的优先级自动挑选，推荐第一种）----------
# 一、账号密码：程序自动向 POST {baseUrl}/api.php/v2/users/login 换取 Token，
#     并在 Token 失效（401）时自动重换并重试一次，无需手工维护。
ZENTAO_ACCOUNT=your-account
ZENTAO_PASSWORD=your-password

# 二、静态 Token（配置了上面两项时本项被忽略）：
#     · 32 位 hex 的 REST Token → 走 `Token` 请求头
#     · `账号:zentaosid`        → 走 zentaosid Cookie（1~5 分钟就过期，不推荐）
# ZENTAO_TOKEN=

# 三、复用官方 zentao-cli 的登录态（本文件与上面两项都为空的兜底）
#     如果本机装过官方 CLI 并 `zentao login` 过，凭证会存在官方 profile store 里。
#     本项目**只读**该文件，绝不修改、绝不往用户目录写任何东西。
#     · 默认路径：~/.config/zentao/zentao.json（Windows：%USERPROFILE%\.config\zentao\zentao.json）
#     · 可用 ZENTAO_CONFIG_FILE 指向别处；用 ZENTAO_PROFILE 指定读哪个 profile
#     · 选不到或用不了时会给出明确报错，不会静默降级
#     ⚠️ store 里**只有 Token、没有密码**，而禅道 REST Token 有寿命（本实例 4 小时）——
#        所以这条路**不能自动续期**，适合临时用；长期无人值守请用上面第一种。
# ZENTAO_PROFILE=
# ZENTAO_CONFIG_FILE=

# ---------- 可选：网络与重试 ----------
# ZENTAO_TIMEOUT=30000        # 单次请求超时（毫秒）
# ZENTAO_RETRY=3              # 网络错误 / 5xx 的重试次数
# ZENTAO_RETRY_DELAY=1000     # 重试间隔（毫秒）
# ZENTAO_REC_PER_PAGE=20      # 每页条数（默认 20；也可按单次调用传 recPerPage 覆盖）
#
# ---------- 可选：自签证书 ----------
# 内网实例常用自签 HTTPS 证书。开启后跳过 TLS 校验（仅用于可信内网）。
# ZENTAO_INSECURE=1
#
# ---------- 可选：显式指定实例版本 ----------
# 实例版本默认由匿名接口 /?mode=getconfig 自动探测（无需登录）。
# 若该接口被网关拦掉、或你想强制按某个版本判定动作可用性，可显式指定。
# 形如：max8.2 / 22.0 / biz13.0 / ipd5.0
# ⚠️ 一般不要配 —— 写错会让你误以为某些动作「不支持」。
# ZENTAO_VERSION=
#
# ---------- 可选：PUT / DELETE 方法覆盖 ----------
# 部分禅道部署的前置 Web 服务器（nginx / Apache / WAF）会在 HTTP 层直接掐断
# PUT/DELETE —— 连接被重置，连响应体都拿不到，表现为 "socket hang up" / ECONNRESET。
# 禅道框架本身支持用 POST + `X-HTTP-Method-Override` 头把请求转成目标方法，
# 从而绕过这类限制。本项目默认会自动处理，一般不用配这一项。
#
# auto（默认）= 先发真实方法，被传输层拒绝时自动改用覆盖重发，并记住本实例的偏好
# always      = 所有 PUT/DELETE 一律走覆盖（已确认实例不支持原生方法时用）
# never       = 永不覆盖（调试原生方法时用）
# ZENTAO_METHOD_OVERRIDE=auto
#
# 若所在环境通过 HTTP_PROXY 出网、而禅道是内网地址，可能被代理拦下。
# 这种情况请把禅道主机加进 NO_PROXY，例如：
# NO_PROXY=zen.example.com,localhost,127.0.0.1

# ---------- 可选：日志 ----------
# DEBUG / INFO / WARN / ERROR，默认 INFO
# 注意：这是 stdio 传输的 MCP 服务器，日志一律走 stderr，stdout 只跑 JSON-RPC。
LOG_LEVEL=INFO

# ---------- 可选：Bug 截图附件下载目录 ----------
# zendao_get_bug_attachments 把截图存到哪儿。
# 默认 {系统临时目录}/zendao-attachments/{bugID}
# ZENTAO_ATTACHMENT_DIR=D:/zendao-attachments

# ---------- 以下仅供测试使用，正常运行不需要 ----------
# NODE_ENV=test
# CACHE_DEFAULT_TTL=300000
# CACHE_MAX_SIZE=1000
